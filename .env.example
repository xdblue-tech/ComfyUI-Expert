# Private media endpoint credentials.
# The CLI does not load .env automatically. From the repository root:
#   set -a; source .env; set +a
# Keep this file private; never commit real credentials.

# Bind settings for `serve`. --host/--port override these; without them the
# defaults are 127.0.0.1:8000. Binding 0.0.0.0 exposes the endpoint on the LAN:
# it does not terminate TLS, so front it with a TLS proxy and pass the client
# host name with --allow-host to keep the Host/Origin guard active.
MEDIAGEN_HOST=0.0.0.0
MEDIAGEN_PORT=7123

# Shared JWT signing secret; keep stable across service restarts.
# To generate a replacement:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MEDIAGEN_JWT_SECRET=''

# Required for planning through the configured OpenAI-compatible proxy.
MEDIAGEN_PROXY_API_KEY=''

# Planning model defaults. serve flags of the same name override these; empty
# or unset values fall back to the pinned defaults shown here.
MEDIAGEN_MODEL_ID=glm-5.3-flash
MEDIAGEN_MODEL_BASE_URL=http://hades.home:8317/v1
# Name of the variable holding the proxy key, not the key itself.
MEDIAGEN_MODEL_API_KEY_ENV=MEDIAGEN_PROXY_API_KEY

# Enable paid generation with true/1/yes/on (case-insensitive). --enable-generation
# and --disable-generation override this; RUNPOD_API_KEY is still required.
MEDIAGEN_ENABLE_GENERATION=false

# Required for generation; serve also needs generation enabled.
RUNPOD_API_KEY=''
