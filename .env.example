# Private media endpoint credentials.
# The CLI does not load .env automatically. From the repository root:
#   set -a; source .env; set +a
# Keep this file private; never commit real credentials.

# Shared JWT signing secret; keep stable across service restarts.
# To generate a replacement:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MEDIAGEN_JWT_SECRET=''

# Required for planning through the configured OpenAI-compatible proxy.
MEDIAGEN_PROXY_API_KEY=''

# Required for generation; serve also needs --enable-generation.
RUNPOD_API_KEY=''
