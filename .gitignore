# Local credentials (keep the template versioned)
.env
.env.*
!.env.example

# Runtime state (machine-specific)
state/*
!state/.gitkeep

# Project outputs (large/personal)
output/
projects/*/outputs/
projects/*/assets/

# Claude Code internals
.claude/settings.local.json

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/
*.swp
*.swo
*~

# pi personal project config (machine-specific)
.pi/settings.json

# Python caches and packaging
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
.venv/

# Private MCP endpoint runtime state (already under state/* and output/)
state/mediagen/
output/mediagen/


# In-repo smoke-test outputs of the distribute package
distribute/output/
distribute/projects/
